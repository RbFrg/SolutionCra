            "description": "`AAAA-MM`",
            "type": "string"
          }
        },
        "required": [
          "mois",
          "libelle",
          "enRetard",
          "justifiees",
          "faites"
        ],
        "type": "object"
      },
      "NomReferentielDto": {
        "enum": [
          "missions",
          "competences",
          "motifs"
        ],
        "type": "string"
      },
      "PlanDto": {
        "properties": {
          "annee": {
            "format": "int32",
            "type": "integer"
          },
          "aujourdhui": {
            "format": "date",
            "type": "string"
          },
          "semaines": {
            "description": "52 ou 53 semaines ; une semaine sans ligne vaut Entreprise (P-04).",
            "items": {
              "$ref": "#/components/schemas/SemaineDto"
            },
            "type": "array"
          }
        },
        "required": [
          "annee",
          "aujourdhui",
          "semaines"
        ],
        "type": "object"
      },
      "PonctualiteDto": {
        "properties": {
          "delaiMoyenJours": {
            "description": "Jours entre le dimanche et la clôture ; zéro ou moins = à l'heure.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "echues": {
            "description": "Semaines échues, attendues, non justifiées.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "ponctuelles": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "taux": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "ponctuelles",
          "echues"
        ],
        "type": "object"
      },
      "Probleme": {
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ErreurChampDto"
            },
            "type": "array"
          },
          "ficheId": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "semainesPasseesTouchees": {
            "items": {
              "format": "date",
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "versionCourante": {
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "QuantiteDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "nom": {
            "type": "string"
          },
          "valeur": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "id",
          "nom",
          "valeur"
        ],
        "type": "object"
      },
      "SauvegarderFicheDto": {
        "properties": {
          "lignes": {
            "items": {
              "$ref": "#/components/schemas/LigneSaisieDto"
            },
            "type": "array"
          },
          "version": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "version",
          "lignes"
        ],
        "type": "object"
      },
      "SemaineDto": {
        "description": "Une semaine et son statut, pour le calendrier, la frise et le plan.",
        "properties": {
          "dimanche": {
            "format": "date",
            "type": "string"
          },
          "echeance": {
            "description": "Dimanche 23h59m59, heure de Paris.",
            "format": "date-time",
            "type": "string"
          },
          "ficheId": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "joursRetard": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "justificationId": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "libelle": {
            "type": [
              "string",
              "null"
            ]
          },
          "lundi": {
            "format": "date",
            "type": "string"
          },
          "motifId": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "numero": {
            "description": "Numéro ISO 8601.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "statut": {
            "$ref": "#/components/schemas/StatutSemaineDto"
          },
          "statutFiche": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StatutFicheDto"
              }
            ]
          },
          "type": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TypeFicheDto",
                "description": "Type évalué : celui du filtre, ou celui du plan pour « toutes »."
              }
            ]
          },
          "typeAttendu": {
            "$ref": "#/components/schemas/TypeAttenduDto"
          }
        },
        "required": [
          "lundi",
          "dimanche",
          "numero",
          "typeAttendu",
          "statut",
          "echeance"
        ],
        "type": "object"
      },
      "SemainePlanDto": {
        "properties": {
          "libelle": {
            "type": [
              "string",
              "null"
            ]
          },
          "lundi": {
            "format": "date",
            "type": "string"
          },
          "numero": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "typeAttendu": {
            "$ref": "#/components/schemas/TypeAttenduDto"
          }
        },
        "required": [
          "lundi",
          "numero",
          "typeAttendu"
        ],
        "type": "object"
      },
      "StatutFicheDto": {
        "enum": [
          "brouillon",
          "terminee",
          "transmise",
          "validee"
        ],
        "type": "string"
      },
      "StatutSemaineDto": {
        "description": "Statut de semaine **calculé par le serveur** ; le front ne le recalcule jamais.",
        "enum": [
          "faite",
          "a_faire",
          "en_retard",
          "a_venir",
          "non_attendue",
          "justifiee"
        ],
        "type": "string"
      },
      "TableauDeBordDto": {
        "properties": {
          "annee": {
            "format": "int32",
            "type": "integer"
          },
          "aujourdhui": {
            "description": "Date de Paris selon le serveur (figée en démo).",
            "format": "date",
            "type": "string"
          },
          "indicateurs": {
            "$ref": "#/components/schemas/IndicateursDto"
          },
          "retards": {
            "description": "Semaines en retard, de la plus ancienne à la plus récente.",
            "items": {
              "$ref": "#/components/schemas/SemaineDto"
            },
            "type": "array"
          },
          "semaineCourante": {
            "format": "date",
            "type": [
              "string",
              "null"
            ]
          },
          "semaines": {
            "description": "Toutes les semaines de l'année (calendrier et frise).",
            "items": {
              "$ref": "#/components/schemas/SemaineDto"
            },
            "type": "array"
          }
        },
        "required": [
          "aujourdhui",
          "annee",
          "indicateurs",
          "retards",
          "semaines"
        ],
        "type": "object"
      },
      "TotauxDto": {
        "properties": {
          "aFaire": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "attendues": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "enRetard": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "faites": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "justifiees": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "tauxFaites": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "attendues",
          "faites",
          "justifiees",
          "enRetard",
          "aFaire"
        ],
        "type": "object"
      },
      "TypeAttenduDto": {
        "enum": [
          "entreprise",
          "formation",
          "aucune"
        ],
        "type": "string"
      },
      "TypeEvenementDto": {
        "enum": [
          "fiche_creee",
          "statut_modifie",
          "fiche_modifiee_apres_transmission",
          "fiche_supprimee",
          "semaine_justifiee",
          "justification_levee",
          "calendrier_modifie",
          "referentiel_modifie",
          "import",
          "export"
        ],
        "type": "string"
      },
      "TypeFicheDto": {
        "enum": [
          "entreprise",
          "formation"
        ],
        "type": "string"
      }
    }
  },
  "info": {
    "description": "API JSON du suivi hebdomadaire des fiches CRA.",
    "license": {
      "identifier": "UNLICENSED",
      "name": "UNLICENSED"
    },
    "title": "Solution CRA Powered by Rust",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/alertes": {
      "get": {
        "operationId": "alertes",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertesDto"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "semaines"
        ]
      }
    },
    "/api/bilan": {
      "get": {
        "operationId": "bilan",
        "parameters": [
          {
            "description": "Année scolaire de début (2026 ou 2027) ; par défaut, celle d'aujourd'hui.",
            "in": "query",
            "name": "annee",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "description": "Filtre de type ; `toutes` par défaut.",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "enum": [
                "toutes",
                "entreprise",
                "formation"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BilanDto"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "bilan"
        ]
      }
    },
    "/api/bilan/{fichier}": {
      "get": {
        "operationId": "bilan_csv",
        "parameters": [
          {
            "description": "totaux.csv, retards-par-mois.csv, justifications-par-motif.csv, temps-par-mission.csv ou temps-par-competence.csv",
            "in": "path",
            "name": "fichier",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Année scolaire de début (2026 ou 2027) ; par défaut, celle d'aujourd'hui.",
            "in": "query",
            "name": "annee",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "description": "Filtre de type ; `toutes` par défaut.",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "enum": [
                "toutes",
                "entreprise",
                "formation"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/csv": {}
            },
            "description": "Tableau en CSV"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Probleme"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "bilan"
        ]
      }
    },
    "/api/config": {
      "get": {
        "operationId": "config",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            },
            "description": "Mode d'exécution et build"
          }
        },
        "tags": [
          "systeme"
        ]
      }
    },
    "/api/demo/entrer": {
      "post": {
        "operationId": "entrer",
        "responses": {
          "204": {
            "description": "Démo uniquement : entre sans mot de passe"
          }
        },
        "tags": [
          "demo"
        ]
      }
    },
    "/api/demo/reinitialiser": {
      "post": {
        "operationId": "reinitialiser",
        "responses": {
          "204": {
            "description": "Démo uniquement : restaure le jeu de départ (M-05)"
          }
        },
        "tags": [
          "demo"
        ]
      }
    },
    "/api/export/complet": {
      "get": {
        "operationId": "complet",
        "parameters": [
          {
            "in": "query",
            "name": "format",
            "required": true,
            "schema": {
              "enum": [
                "csv",
                "json"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {}
            },
            "description": "JSON unique ou archive zip de CSV"
          }
        },
        "tags": [
          "exports"
        ]
      }
    },
    "/api/export/lot": {
      "get": {
        "operationId": "lot",
        "parameters": [
          {
            "in": "query",
            "name": "periode",
            "required": true,
            "schema": {
              "enum": [
                "mois",
                "annee"
              ],
              "type": "string"
            }
          },
          {
            "description": "`2026-10` pour un mois, `2026` pour une année scolaire.",
            "in": "query",
            "name": "valeur",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "enum": [
                "toutes",
                "entreprise",
                "formation"
              ],
              "type": "string"
            }
          },
          {
            "description": "`docx` ou `pdf` (`html` accepté).",
            "in": "query",
            "name": "format",
            "required": true,
            "schema": {
              "enum": [
                "html",
                "docx",
                "pdf"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {}
            },
            "description": "Une fiche par page (PDF) ou par section (Word)"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Probleme"
                }
              }
            },
            "description": "Aucune fiche pour cette période"
          }
        },
        "tags": [
          "exports"
        ]
      }
    },
    "/api/fiches": {
      "get": {
        "operationId": "lister_fiches",
        "parameters": [
          {
            "in": "query",
            "name": "annee",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "enum": [
                "toutes",
                "entreprise",
                "formation"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "statut",
            "required": false,
            "schema": {
              "enum": [
                "brouillon",
                "terminee",
                "transmise",
                "validee"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FicheResumeDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "fiches"
        ]
      },
      "post": {
        "operationId": "creer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreerFicheDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FicheDto"
                }
              }
            },
            "description": "",
            "headers": {
              "Location": {
                "description": "/api/fiches/{id}",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Probleme"
                }
              }
            },
            "description": "fiche-existante"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Probleme"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "fiches"
        ]
      }
    },
    "/api/fiches/{id}": {
      "delete": {
        "operationId": "supprimer",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Fiche supprimée ; le journal la garde"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Probleme"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "fiches"
        ]
      },
      "get": {
        "operationId": "lire_fiche",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FicheDto"
                }
              }
            },
            "description": ""
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Probleme"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "fiches"
        ]
      },
      "put": {
        "operationId": "sauvegarder",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SauvegarderFicheDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FicheDto"
                }
              }
            },
            "description": ""
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Probleme"
                }
              }
            },
            "description": "conflit-de-version"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Probleme"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "fiches"
        ]
      }
    },
    "/api/fiches/{id}/export": {
      "get": {
        "operationId": "exporter_fiche",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "format",
            "required": true,
            "schema": {
              "enum": [
                "html",
                "docx",
                "pdf"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {}
            },
            "description": "Fichier HTML (styles en ligne), Word ou PDF"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Probleme"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "exports"
        ]
      }
    },
    "/api/fiches/{id}/statut": {
      "put": {
        "operationId": "changer_statut",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangerStatutDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FicheDto"
                }
              }
            },
            "description": ""
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Probleme"
